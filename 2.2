# Exercise 2.2 from Think Python, Chapter 2
# Using Python as a calculator for the given problems

import math

# Part 1: Volume of a sphere with radius 5
# Formula: V = (4/3) * π * r³
radius = 5
volume = (4 / 3) * math.pi * (radius ** 3)
print(f"1. Volume of sphere with radius {radius}: {volume:.2f} cubic units")

# Part 2: Total wholesale cost for 60 copies of the book
cover_price = 24.95
discount_rate = 0.40
discounted_price = cover_price * (1 - discount_rate)
num_copies = 60
books_cost = num_copies * discounted_price
shipping_first = 3.00
shipping_additional = 0.75
shipping_total = shipping_first + (num_copies - 1) * shipping_additional
total_wholesale_cost = books_cost + shipping_total
print(f"2. Total wholesale cost for {num_copies} copies: ${total_wholesale_cost:.2f}")

# Part 3: Running time calculation
# Start time: 6:52 AM
# Times in minutes:seconds
# First mile: 8:15 -> 8*60 + 15 = 495 seconds
# 3 miles tempo: 3 * (7*60 + 12) = 3 * 432 = 1296 seconds
# Last mile: 495 seconds
# Total seconds: 495 + 1296 + 495 = 2286 seconds

start_hour = 6
start_minute = 52
total_seconds = 495 + 1296 + 495  # Total running time in seconds
total_minutes = total_seconds // 60
extra_seconds = total_seconds % 60
added_minutes = total_minutes
end_minute = start_minute + added_minutes
end_hour = start_hour + (end_minute // 60)
end_minute = end_minute % 60

# Adjust for AM/PM if needed, but since it's morning run, stays AM
print(f"3. Start time: {start_hour}:{start_minute:02d} AM")
print(f"Total running time: {total_minutes} minutes {extra_seconds} seconds")
print(f"End time: {end_hour}:{end_minute:02d} AM")

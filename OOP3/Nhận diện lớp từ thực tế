// lop con cho
class Dog:
    def __init__(self, name, color, breed, emotion):
        self.name = name
        self.color = color
        self.breed = breed
        self.emotion = emotion

    def __str__(self):
        return f"Con chó {self.name} - Màu: {self.color}, Giống: {self.breed}, Cảm xúc: {self.emotion}"


# Danh sách quản lý chó
dog_list = []

# Nhập danh sách chó bằng vòng lặp while
while True:
    name = input("Nhập tên chó (hoặc 'q' để thoát): ")
    if name.lower() == 'q':
        break
    color = input("Nhập màu sắc: ")
    breed = input("Nhập giống: ")
    emotion = input("Nhập cảm xúc: ")

    dog = Dog(name, color, breed, emotion)
    dog_list.append(dog)

print("\nDanh sách chó đã nhập:")
# In danh sách bằng vòng lặp for
for dog in dog_list:
    print(dog)

// lop tai khoan
class BankAccount:
    def __init__(self, account_name, account_number, bank, balance=0):
        self.account_name = account_name
        self.account_number = account_number
        self.bank = bank
        self.balance = balance

    def __str__(self):
        return f"Tài khoản {self.account_name} - Số TK: {self.account_number}, Ngân hàng: {self.bank}, Số dư: {self.balance}"


# Quản lý danh sách Tài khoản
account_list = []

while True:
    account_name = input("Nhập tên tài khoản (hoặc 'q' để thoát): ")
    if account_name.lower() == 'q':
        break
    account_number = input("Nhập số tài khoản: ")
    bank = input("Nhập tên ngân hàng: ")
    balance = float(input("Nhập số dư: "))

    acc = BankAccount(account_name, account_number, bank, balance)
    account_list.append(acc)

print("\nDanh sách tài khoản:")
for acc in account_list:
    print(acc)



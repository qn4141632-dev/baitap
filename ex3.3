def draw_any_grid(rows, cols, cell_width=4, cell_height=4):
    """
    Ve luoi voi kich thuoc tuy chinh.
    - rows: so hang
    - cols: so cot
    - cell_width: do rong moi o (so dau '-')
    - cell_height: chieu cao moi o (so hang '|')
    """
    # Xay dung hang ngang
    horizontal = ('+ ' + '- ' * cell_width) * cols + '+'

    # Xay dung hang doc
    vertical = ('| ' + '  ' * cell_width) * cols + '|'

    for row in range(rows):
        print(horizontal)                     # In hang ngang
        for _ in range(cell_height):          # In cac hang doc
            print(vertical)

    print(horizontal)  # In hang ngang cuoi cung

# Goi ham
print("=== Luoi 2x2 ===")
draw_any_grid(2, 2)

print("\n=== Luoi 4x4 ===")
draw_any_grid(4, 4)

print("\n=== Luoi 3x5 ===")
draw_any_grid(3, 5)
